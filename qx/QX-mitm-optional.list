# 需要 MITM 才生效的规则（url-regex / user-agent）
# 用法：先在配置 [mitm] 里写明 hostname，再把下面这些行追加进 [filter_local]
# 直接放进远程分流资源会被 QX 判 Invalid Line，导致整份资源加载失败

user-agent,Argo*,🎥 NETFLIX
url-regex,^https?:\/\/www\.amazon\.com\/(Amazon-Video|gp\/video)\/,🌍 国外媒体
url-regex,^https?:\/\/int[\w-\.]+iqiyi\.com,🌏 国内媒体
url-regex,(Subject|HELO|SMTP),🎯 全球直连
url-regex,(api|ps|sv|offnavi|newvector|ulog.imap|newloc)(.map|).(baidu|n.shifen).com,🎯 全球直连
url-regex,(.+.|^)(360|so|qihoo|360safe|qhimg|360totalsecurity|yunpan).(cn|com),🎯 全球直连
url-regex,(.+.)?(torrent|announce.php?passkey=|tracker|BitTorrent|bt_key|ed2k|find_node|get_peers|info_hash|magnet:|peer_id=|xunlei)(..+)?,🎯 全球直连
url-regex,(.?)(xunlei|sandai|Thunder|XLLiveUD)(.),🎯 全球直连
url-regex,(.+\.|^)(360|so)\.(cn|com),🎯 全球直连
url-regex,assets\d+\.xboxlive\.(com|cn),🎯 全球直连
